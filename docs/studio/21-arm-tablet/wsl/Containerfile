# Study 21 (R87): Meridiana's dependencies on Linux aarch64, emulated with qemu-user on the x86_64 WSL.
# Debian trixie has glibc 2.41: the PySide6 6.12.0 aarch64 wheels are manylinux_2_39 (bookworm's 2.36 is too old).
FROM docker.io/library/python:3.12-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libegl1 libopengl0 libgl1-mesa-dri libglib2.0-0 libxkbcommon0 libfontconfig1 libfreetype6 \
        libdbus-1-3 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xkb1 libxkbcommon-x11-0 \
        libpulse0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --only-binary=:all: \
        "PySide6_Essentials==6.12.0" "PySide6_Addons==6.12.0" "PySide6_Pdf==6.12.0.140" \
        "shapely>=2.0" "numpy>=1.26" "pandas>=2.2" "requests>=2.31" "pvlib==0.16.1" "scipy>=1.15" \
        "matplotlib>=3.9" "pyqtgraph>=0.14" "pypdf>=6.0" "keyring>=25.7" "ifcopenshell>=0.9.0.post1" \
    && pip list
