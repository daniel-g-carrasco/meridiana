#, python-brace-format
msgid "the best in Italian of those that fit, and good with tools (Tau2 {score} by Google); not yet tried with Meridio"
msgstr "il migliore in italiano tra quelli che entrano, e buono con gli strumenti (Tau2 {score} secondo Google); non ancora provato con Meridio"

msgid "it says it calls tools"
msgstr "dice di saper chiamare gli strumenti"

