msgid "Both views closer; + and Ctrl++ do the same"
msgstr "Avvicina entrambe le viste; + e Ctrl++ fanno lo stesso"

#: src/meridiana/ui/window.py:910
msgid "Both views farther away; - and Ctrl+- do the same"
msgstr "Allontana entrambe le viste; - e Ctrl+- fanno lo stesso"

#: src/meridiana/ui/window.py:914
msgid "Choose a side of the selected outline; the plan turns parallel to it"
msgstr ""
"Scegli un lato del contorno selezionato; la pianta ruota parallelamente a "
"esso"

#: src/meridiana/ui/window.py:915
msgid "The plan with true North up again"
msgstr "Riporta la pianta con il nord vero in alto"

#: src/meridiana/ui/window.py:921
msgid ""
"Each string as a line through its modules, in a colour of its own; always "
"shown in the Plant phase"
msgstr ""
"Ogni stringa come una linea tra i suoi moduli, in un colore proprio; sempre "
"visibili nella fase Impianto"

