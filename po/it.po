#: src/meridiana/energy/stringing.py:158
msgid ""
"Uoc max within the maximum DC voltage of the inverter and of the modules"
msgstr "Uoc max entro la tensione DC massima dell'inverter e dei moduli"

#: src/meridiana/energy/stringing.py:159
#, python-brace-format
