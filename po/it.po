msgid "usable energy"
msgstr "energia utilizzabile"

#: src/meridiana/energy/economics.py:226
msgid "charge power"
msgstr "potenza di carica"

#: src/meridiana/energy/economics.py:227
msgid "discharge power"
msgstr "potenza di scarica"

#: src/meridiana/energy/economics.py:228
msgid "round-trip efficiency"
msgstr "rendimento di ciclo"

#: src/meridiana/energy/economics.py:229
msgid "energy into the battery, first year"
msgstr "energia in batteria, primo anno"

#: src/meridiana/energy/economics.py:230
msgid "energy from the battery to the loads"
msgstr "energia dalla batteria ai carichi"

#: src/meridiana/energy/economics.py:233
msgid "Export limit at the injection point"
msgstr "Limite di immissione nel punto di connessione"

#: src/meridiana/energy/economics.py:235
msgid "Above the power the grid may take, the inverters hold the production back: that energy is lost."
msgstr "Oltre la potenza che la rete può ricevere, gli inverter trattengono la produzione: quell'energia va persa."

