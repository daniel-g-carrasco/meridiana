#: src/meridiana/ui/window.py:4891
#, python-brace-format
msgid ""
"<b>Meridiana</b> {version}<br>Photovoltaic design: map, building model, sun "
"path, module layout and Italian standards.<br><br>GPL-3.0-or-later. Qt for "
"Python (LGPL), Qt Quick 3D (GPL), shapely (BSD), numpy (BSD). Backgrounds: "
"the map sources of Settings > Maps, each named on the plan with its "
"attribution (among them the national orthophoto of the Geoportale Nazionale, "
"MASE, and © OpenStreetMap contributors); the outlines of their areas from "
"Natural Earth (public domain)."
msgstr ""
"<b>Meridiana</b> {version}<br>Progettazione fotovoltaica: mappa, modello "
"dell'edificio, percorso del sole, posa dei moduli e norme italiane."
"<br><br>GPL-3.0 o successive. Qt for Python (LGPL), Qt Quick 3D (GPL), "
"shapely (BSD), numpy (BSD). Sfondi: le sorgenti delle mappe di Impostazioni "
"> Mappe, ciascuna indicata sulla pianta con la sua attribuzione (fra queste "
"l'ortofoto nazionale del Geoportale Nazionale, MASE, e © contributori di "
"OpenStreetMap); i contorni delle loro aree da Natural Earth (pubblico "
"dominio)."

