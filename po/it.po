#: src/meridiana/__main__.py:29
#, python-brace-format
msgid "usage: {command} [PROJECT]"
msgstr "uso: {command} [PROGETTO]"

#: src/meridiana/assistant/costs.py:29
msgid "Claude Haiku 5.5, for the current questions"
msgstr "Claude Haiku 5.5, per le domande correnti"

#: src/meridiana/assistant/costs.py:30
msgid "Claude Sonnet 5.5, for the hard ones"
msgstr "Claude Sonnet 5.5, per quelle difficili"

#: src/meridiana/assistant/costs.py:72
#, python-brace-format
msgid "{cents} dollar cents"
msgstr "{cents} centesimi di dollaro"

#: src/meridiana/assistant/costs.py:73
#, python-brace-format
msgid "{dollars} $"
msgstr "{dollars} $"

#: src/meridiana/assistant/costs.py:78
#, python-brace-format
msgid "{n} tokens"
msgstr "{n} token"

#: src/meridiana/assistant/costs.py:80
#, python-brace-format
msgid "Local, no cost · {tokens}"
msgstr "Locale, nessun costo · {tokens}"

#: src/meridiana/assistant/costs.py:81
msgid "price unknown"
msgstr "prezzo non noto"

#: src/meridiana/assistant/costs.py:82
#, python-brace-format
msgid "{tokens} · about {cost} (prices of {date})"
msgstr "{tokens} · circa {cost} (prezzi del {date})"

#: src/meridiana/assistant/local.py:48
msgid "an OpenAI-compatible server"
msgstr "un server compatibile con OpenAI"

#: src/meridiana/assistant/local.py:96
msgid ""
"open Ollama from the Start menu (it stays in the notification area), or run: "
"ollama serve"
msgstr ""
"apri Ollama dal menu Start (resta nell'area di notifica), oppure esegui: "
"ollama serve"

#: src/meridiana/assistant/local.py:97
msgid ""
"start its server: lms server start (or Developer > Start server in LM Studio)"
msgstr ""
"avvia il suo server: lms server start (oppure Developer > Start server in LM "
"Studio)"

#: src/meridiana/assistant/local.py:98
msgid ""
"start it with a model, for example: llama-server -hf unsloth/Qwen3.6-35B-A3B-"
"GGUF:UD-IQ4_XS -c 16384"
msgstr ""
"avvialo con un modello, per esempio: llama-server -hf unsloth/Qwen3.6-35B-"
"A3B-GGUF:UD-IQ4_XS -c 16384"

#: src/meridiana/assistant/local.py:100
msgid "in Jan: Settings > Local API Server > Start Server"
msgstr "in Jan: Settings > Local API Server > Start Server"

#: src/meridiana/assistant/local.py:101
msgid "find its address with: foundry server status"
msgstr "trova il suo indirizzo con: foundry server status"

#: src/meridiana/assistant/local.py:200
msgid ""
"it wants an API key: Meridio does not send one to a local server; turn the "
"key off in its settings"
msgstr ""
"chiede una chiave API: Meridio non ne manda a un server locale; togli la "
"chiave nelle sue impostazioni"

#: src/meridiana/assistant/local.py:252
#, python-brace-format
msgid ""
"{model} is loaded with {n} tokens of context: Meridio wants at least {min}; "
"load it with: lms load {model} --context-length 16384"
msgstr ""
"{model} è caricato con un contesto di {n} token: Meridio ne vuole almeno "
"{min}; caricalo con: lms load {model} --context-length 16384"

#: src/meridiana/assistant/local.py:305
#, python-brace-format
msgid ""
"its context is {n} tokens: Meridio wants at least {min}; start it with -c "
"16384"
msgstr ""
"il suo contesto è di {n} token: Meridio ne vuole almeno {min}; avvialo con "
"-c 16384"

#: src/meridiana/assistant/local.py:407
msgid ""
"its port changes at every start: find it with foundry server status and "
"write the address in the field above"
msgstr ""
"la sua porta cambia a ogni avvio: trovala con foundry server status e scrivi "
"l'indirizzo nel campo qui sopra"

#: src/meridiana/assistant/local.py:556
msgid ""
"tried with Meridio's tools (study 14): it reads before answering, proposes "
"the fixes and does not invent; a mixture of experts with 3 billion "
"parameters at work, quick even on the processor"
msgstr ""
"provato con gli strumenti di Meridio (studio 14): legge prima di rispondere, "
"propone le correzioni e non inventa; un modello a esperti con 3 miliardi di "
"parametri al lavoro, veloce anche sul processore"

#: src/meridiana/assistant/local.py:559
#, python-brace-format
msgid ""
"the best in Italian of those that fit, and good with tools (Tau2 {score} by "
"Google); not yet tried with Meridio"
msgstr ""
"il migliore in italiano tra quelli che entrano, e buono con gli strumenti "
"(Tau2 {score} secondo Google); non ancora provato con Meridio"

#: src/meridiana/assistant/local.py:561
msgid ""
"mature with tools and quick; weaker in Italian, and its reasoning cannot be "
"turned off (Meridiana keeps it low)"
msgstr ""
"maturo con gli strumenti e veloce; più debole in italiano, e il suo "
"ragionamento non si spegne (Meridiana lo tiene basso)"

#: src/meridiana/assistant/local.py:563
msgid ""
"it fits whole in a card of 8 GB, so it is the quickest; good with tools by "
"its makers' measures, not yet tried with Meridio"
msgstr ""
"entra tutto in una scheda da 8 GB, quindi è il più veloce; buono con gli "
"strumenti secondo le misure di chi lo ha fatto, non ancora provato con "
"Meridio"

#: src/meridiana/assistant/local.py:565
msgid "small and good in Italian; with tools a step below Qwen3.5-9B"
msgstr ""
"piccolo e buono in italiano; con gli strumenti un gradino sotto Qwen3.5-9B"

#: src/meridiana/assistant/local.py:566
msgid ""
"small, Italian among its languages; out on 23/10/2026, still to be tried"
msgstr ""
"piccolo, con l'italiano tra le sue lingue; uscito il 23/10/2026, ancora da "
"provare"

#: src/meridiana/assistant/local.py:567
msgid ""
"speaks Italian, calls tools, never reasons at length; no published measure "
"of its tools"
msgstr ""
"parla italiano, chiama gli strumenti, non ragiona a lungo; nessuna misura "
"pubblicata dei suoi strumenti"

#: src/meridiana/assistant/local.py:568
msgid "very quick with tools, but it always reasons before answering"
msgstr "velocissimo con gli strumenti, ma ragiona sempre prima di rispondere"

#: src/meridiana/assistant/local.py:569
msgid "good with tools by NVIDIA's measures; large for what it gives"
msgstr ""
"buono con gli strumenti secondo le misure di NVIDIA; grande per quello che dà"

#: src/meridiana/assistant/local.py:570 src/meridiana/assistant/local.py:571
msgid "strong, but dense: slow without a large card"
msgstr "forte, ma denso: lento senza una scheda grande"

#: src/meridiana/assistant/local.py:572
msgid ""
"for a PC with little memory: in the trial of study 14 it invented what it "
"did not find"
msgstr ""
"per un PC con poca memoria: nella prova dello studio 14 inventava quello che "
"non trovava"

#: src/meridiana/assistant/local.py:573
msgid "the generation before 2026: good with tools, less in Italian"
msgstr ""
"la generazione prima del 2026: buona con gli strumenti, meno in italiano"

#: src/meridiana/assistant/local.py:574
msgid "of 2024: overtaken"
msgstr "del 2024: superato"

#: src/meridiana/assistant/local.py:575
msgid "Ollama does not mark it as calling tools"
msgstr "Ollama non lo segna tra quelli che chiamano strumenti"

#: src/meridiana/assistant/local.py:646
msgid "it says it calls tools"
msgstr "dice di saper chiamare gli strumenti"

#: src/meridiana/assistant/local.py:647
msgid "a model Meridiana does not know yet: try it with «Test»"
msgstr "un modello che Meridiana non conosce ancora: provalo con «Prova»"

#: src/meridiana/assistant/local.py:648
#, python-brace-format
msgid "{model} on {runtime}: {why}."
msgstr "{model} su {runtime}: {why}."

#: src/meridiana/assistant/local.py:650
#, python-brace-format
msgid "It takes about {need} GB; this PC has about {budget} for a model."
msgstr "Occupa circa {need} GB; questo PC ne ha circa {budget} per un modello."

#: src/meridiana/assistant/local.py:651
#, python-brace-format
msgid ""
"It takes about {need} GB and this PC has about {budget} for a model: it may "
"be slow or not load."
msgstr ""
"Occupa circa {need} GB e questo PC ne ha circa {budget} per un modello: "
"potrebbe essere lento o non caricarsi."

#: src/meridiana/assistant/local.py:698
#, python-brace-format
msgid ""
"Install Ollama: the installer from ollama.com/download (about {size} GB, no "
"administrator needed), or from the Command Prompt:"
msgstr ""
"Installa Ollama: l'installatore da ollama.com/download (circa {size} GB, "
"senza permessi di amministratore), oppure dal Prompt dei comandi:"

#: src/meridiana/assistant/local.py:702
msgid "Install Ollama: the app from ollama.com/download."
msgstr "Installa Ollama: l'app da ollama.com/download."

#: src/meridiana/assistant/local.py:704
msgid ""
"Install Ollama, from a terminal (it asks for the password of the "
"administrator):"
msgstr ""
"Installa Ollama da un terminale (chiede la password di amministratore):"

#: src/meridiana/assistant/local.py:707
#, python-brace-format
msgid "Download the model, about {size} GB (once):"
msgstr "Scarica il modello, circa {size} GB (una volta sola):"

#: src/meridiana/assistant/local.py:709
msgid ""
"Ollama keeps running by itself. Back here: «Search again», then «Use it» and "
"«Test»."
msgstr ""
"Ollama resta in funzione da solo. Poi torna qui: «Cerca di nuovo», quindi "
"«Usa questo» e «Prova»."

#: src/meridiana/assistant/local.py:791
msgid "Nothing answers at that address: is the server running?"
msgstr "A quell'indirizzo non risponde nessuno: il server è avviato?"

#: src/meridiana/assistant/local.py:792
#, python-brace-format
msgid "The server answers but does not have the model {model}."
msgstr "Il server risponde ma non ha il modello {model}."

#: src/meridiana/assistant/local.py:793
#, python-brace-format
msgid ""
"The model {model} does not call tools: Meridio needs them. Choose another "
"one."
msgstr ""
"Il modello {model} non chiama gli strumenti, che servono a Meridio. Scegline "
"un altro."

#: src/meridiana/assistant/local.py:795
#, python-brace-format
msgid "The server answered with an error: {detail}"
msgstr "Il server ha risposto con un errore: {detail}"

#: src/meridiana/assistant/local.py:799
#, python-brace-format
msgid ""
"It works: {model} answered in {s} s and called the tool as Meridio needs."
msgstr ""
"Funziona: {model} ha risposto in {s} s e ha chiamato lo strumento come serve "
"a Meridio."

#: src/meridiana/assistant/local.py:801
#, python-brace-format
msgid ""
"{model} answered in {s} s but did not call the tool: Meridio may not read "
"the project with it. A model of the list above calls tools better."
msgstr ""
"{model} ha risposto in {s} s ma non ha chiamato lo strumento: con lui "
"Meridio potrebbe non riuscire a leggere il progetto. Un modello dell'elenco "
"qui sopra chiama meglio gli strumenti."

#: src/meridiana/assistant/persona.py:84
#, python-brace-format
msgid ""
"Hi, I am {name}, Meridiana's assistant. I read your project (the checks, the "
"results, the rules) and answer with the sources; when a figure comes from an "
"assumption, I tell you. I change nothing by myself: I propose, you apply "
"with a click, and Ctrl+Z undoes it. I think with the local model on this PC; "
"with Claude only if you choose it and agree. Where shall we start?"
msgstr ""
"Ciao, sono {name}, l'assistente di Meridiana. Leggo il tuo progetto "
"(verifiche, risultati, regole) e ti rispondo con le fonti; se una cifra "
"viene da un'ipotesi, te lo dico. Da solo non cambio niente: ti propongo le "
"modifiche, le applichi tu con un clic e Ctrl+Z le annulla. Penso con il "
"modello locale di questo PC; con Claude solo se lo scegli tu e acconsenti. "
"Da dove cominciamo?"

#: src/meridiana/assistant/persona.py:92
#, python-brace-format
msgid "{name} here. Ask me about the project, or pick a question below."
msgstr ""
"Eccomi, sono {name}. Chiedimi del progetto, o scegli una domanda qui sotto."

#: src/meridiana/assistant/privacy.py:121
#, python-brace-format
msgid ""
"To {who}, model {model}: your questions and what Meridio reads to answer "
"them (the checks, a summary of the project, the results), never the project "
"file."
msgstr ""
"A {who}, modello {model}: le tue domande e ciò che Meridio legge per "
"rispondere (le verifiche, un riassunto del progetto, i risultati), mai il "
"file del progetto."

#: src/meridiana/assistant/privacy.py:123
msgid ""
"The project's name, its address and the file's name are replaced by "
"placeholders; the coordinates are rounded to about 1 km."
msgstr ""
"Il nome del progetto, l'indirizzo e il nome del file sono sostituiti da "
"segnaposto; le coordinate sono arrotondate a circa 1 km."

#: src/meridiana/assistant/privacy.py:125
msgid ""
"Anthropic does not train its models on what the API receives and deletes it "
"within 30 days (its commercial terms, read on 22/10/2026). The servers may "
"be outside the EU."
msgstr ""
"Anthropic non addestra i suoi modelli su ciò che riceve dall'API e lo "
"cancella entro 30 giorni (i suoi termini commerciali, letti il 22/10/2026). "
"I server possono essere fuori dall'UE."

#: src/meridiana/assistant/privacy.py:127
msgid ""
"A project marked reserved never leaves the PC: its questions go to the local "
"model."
msgstr ""
"Un progetto segnato come riservato non esce mai dal PC: le sue domande vanno "
"al modello locale."

#: src/meridiana/assistant/speech.py:37
msgid "Nicola, a man's voice"
msgstr "Nicola, voce maschile"

#: src/meridiana/assistant/speech.py:37
msgid "Sara, a woman's voice"
msgstr "Sara, voce femminile"

#: src/meridiana/assistant/speech.py:38
msgid "Michael, a man's voice"
msgstr "Michael, voce maschile"

#: src/meridiana/assistant/speech.py:38
msgid "Heart, a woman's voice"
msgstr "Heart, voce femminile"

#: src/meridiana/assistant/speech.py:115
#, python-brace-format
msgid "{file} did not arrive whole: its fingerprint is not the release's."
msgstr ""
"{file} non è arrivato intero: la sua impronta non è quella della "
"pubblicazione."

#: src/meridiana/assistant/suggestions.py:121
msgid "Which one do I fix first?"
msgstr "Quale sistemo per primo?"

#: src/meridiana/assistant/suggestions.py:122
#: src/meridiana/assistant/suggestions.py:341
#, python-brace-format
msgid "How do I fix «{check}»?"
msgstr "Come sistemo «{check}»?"

#: src/meridiana/assistant/suggestions.py:123
msgid "Is there anything else to fix before the report?"
msgstr "C'è altro da sistemare prima della relazione?"

#: src/meridiana/assistant/suggestions.py:125
msgid "Which fire brigade rule sets these distances?"
msgstr "Quale regola dei vigili del fuoco fissa queste distanze?"

#: src/meridiana/assistant/suggestions.py:126 src/meridiana/phases.py:89
msgid "Are the distances from the edges right for the fire brigade?"
msgstr "Le distanze dai bordi vanno bene per i Vigili del Fuoco?"

#: src/meridiana/assistant/suggestions.py:127
msgid "Can I gain modules and keep the passages free?"
msgstr "Posso guadagnare moduli lasciando liberi i percorsi?"

#: src/meridiana/assistant/suggestions.py:129
msgid "How much energy does the shade cost?"
msgstr "Quanta energia mi costa l'ombra?"

#: src/meridiana/assistant/suggestions.py:130
msgid "Which sub-field suffers most from the shade?"
msgstr "Quale sottocampo soffre di più l'ombra?"

#: src/meridiana/assistant/suggestions.py:131
msgid "What if I kept the modules out of the obstacles' shade?"
msgstr "E se tenessi i moduli fuori dall'ombra degli ostacoli?"

#: src/meridiana/assistant/suggestions.py:133
msgid "How many modules in series at most, and why?"
msgstr "Quanti moduli in serie al massimo, e perché?"

#: src/meridiana/assistant/suggestions.py:134 src/meridiana/phases.py:102
msgid "Does this string hold at -10 °C?"
msgstr "Questa stringa regge a -10 °C?"

#: src/meridiana/assistant/suggestions.py:135 src/meridiana/phases.py:101
msgid "Are the strings right for this inverter?"
msgstr "Le stringhe vanno bene per questo inverter?"

#: src/meridiana/assistant/suggestions.py:137 src/meridiana/phases.py:103
msgid "Is the DC/AC ratio reasonable here?"
msgstr "Il rapporto DC/AC è ragionevole qui?"

#: src/meridiana/assistant/suggestions.py:138
msgid "Would a smaller or a larger inverter be better?"
msgstr "Sarebbe meglio un inverter più piccolo o più grande?"

#: src/meridiana/assistant/suggestions.py:139
msgid "Do power optimizers make sense here?"
msgstr "Qui hanno senso gli ottimizzatori?"

#: src/meridiana/assistant/suggestions.py:141
#, python-brace-format
msgid "Is the layout of «{name}» right?"
msgstr "La posa di «{name}» va bene?"

#: src/meridiana/assistant/suggestions.py:142 src/meridiana/phases.py:90
msgid "Where can I gain power without shadows?"
msgstr "Dove recupero potenza senza ombre?"

#: src/meridiana/assistant/suggestions.py:143
msgid "Would another tilt or row pitch give more energy?"
msgstr ""
"Con un'altra inclinazione o un altro passo tra le file produrrei di più?"

#: src/meridiana/assistant/suggestions.py:145
#: src/meridiana/assistant/suggestions.py:347
msgid "What is missing to compute the year?"
msgstr "Che cosa manca per calcolare l'anno?"

#: src/meridiana/assistant/suggestions.py:146
#: src/meridiana/assistant/suggestions.py:153 src/meridiana/phases.py:113
msgid "Which losses weigh most?"
msgstr "Quali perdite pesano di più?"

#: src/meridiana/assistant/suggestions.py:147 src/meridiana/phases.py:114
msgid "Is this specific yield plausible for the site?"
msgstr "Questa resa specifica è plausibile per il sito?"

#: src/meridiana/assistant/suggestions.py:148
msgid "How far is it from PVGIS?"
msgstr "Quanto si scosta da PVGIS?"

#: src/meridiana/assistant/suggestions.py:149
msgid "Where do the weather data come from?"
msgstr "Da dove vengono i dati meteo?"

#: src/meridiana/assistant/suggestions.py:151
msgid "Which of these losses can I reduce?"
msgstr "Quali di queste perdite posso ridurre?"

#: src/meridiana/assistant/suggestions.py:152
#: src/meridiana/assistant/suggestions.py:158
msgid "Which values behind it are Meridiana's defaults?"
msgstr "Quali valori dietro questo calcolo sono quelli di serie di Meridiana?"

#: src/meridiana/assistant/suggestions.py:154
msgid "Which losses does Meridiana count, and how?"
msgstr "Quali perdite conta Meridiana, e come?"

#: src/meridiana/assistant/suggestions.py:156 src/meridiana/phases.py:112
msgid "Why is the performance ratio this one?"
msgstr "Perché l'indice di rendimento è questo?"

#: src/meridiana/assistant/suggestions.py:157
msgid "Which losses lower the PR most?"
msgstr "Quali perdite abbassano di più il PR?"

#: src/meridiana/assistant/suggestions.py:160
msgid "Where does this figure come from?"
msgstr "Da dove viene questa cifra?"

#: src/meridiana/assistant/suggestions.py:161
#: src/meridiana/assistant/suggestions.py:181 src/meridiana/phases.py:147
msgid "Which values are still at their default?"
msgstr "Quali valori sono ancora quelli predefiniti?"

#: src/meridiana/assistant/suggestions.py:162
msgid "How do I put a value of mine instead of the default?"
msgstr "Come metto un valore mio al posto di quello di serie?"

#: src/meridiana/assistant/suggestions.py:164 src/meridiana/phases.py:120
msgid "Does this load profile look plausible?"
msgstr "Questo profilo dei consumi è plausibile?"

#: src/meridiana/assistant/suggestions.py:165 src/meridiana/phases.py:121
msgid "How much of the production is used on site?"
msgstr "Quanta produzione si consuma sul posto?"

#: src/meridiana/assistant/suggestions.py:166
msgid "How do I import the real load curve?"
msgstr "Come importo la curva di carico vera?"

#: src/meridiana/assistant/suggestions.py:168 src/meridiana/phases.py:122
msgid "Would a battery help here?"
msgstr "Qui servirebbe una batteria?"

#: src/meridiana/assistant/suggestions.py:169
msgid "How big should the battery be?"
msgstr "Di che taglia dovrebbe essere la batteria?"

#: src/meridiana/assistant/suggestions.py:170 src/meridiana/phases.py:133
msgid "What would change with a battery?"
msgstr "Che cosa cambierebbe con una batteria?"

#: src/meridiana/assistant/suggestions.py:172 src/meridiana/phases.py:132
msgid "What weighs most on the payback?"
msgstr "Che cosa pesa di più sul rientro?"

#: src/meridiana/assistant/suggestions.py:173 src/meridiana/phases.py:131
msgid "Is the investment worth it?"
msgstr "L'investimento conviene?"

#: src/meridiana/assistant/suggestions.py:174
msgid "Which prices and costs are still at their default?"
msgstr "Quali prezzi e costi sono ancora quelli di serie?"

#: src/meridiana/assistant/suggestions.py:176
msgid "Which rules apply to this plant?"
msgstr "Quali regole valgono per questo impianto?"

#: src/meridiana/assistant/suggestions.py:177
msgid "What is the source of this rule?"
msgstr "Qual è la fonte di questa regola?"

#: src/meridiana/assistant/suggestions.py:178
msgid "Who may sign this project?"
msgstr "Chi può firmare questo progetto?"

#: src/meridiana/assistant/suggestions.py:180 src/meridiana/phases.py:146
msgid "Is the report complete for the client?"
msgstr "La relazione è completa per il committente?"

#: src/meridiana/assistant/suggestions.py:182 src/meridiana/phases.py:148
msgid "What should the installer get with the drawings?"
msgstr "Che cosa deve ricevere l'installatore con i disegni?"

#: src/meridiana/assistant/suggestions.py:184
msgid "How do I compare the variants?"
msgstr "Come confronto le varianti?"

#: src/meridiana/assistant/suggestions.py:185
msgid "Which variant gives the most energy?"
msgstr "Quale variante produce di più?"

#: src/meridiana/assistant/suggestions.py:186
msgid "How do I try another layout without losing this one?"
msgstr "Come provo un'altra posa senza perdere questa?"

#: src/meridiana/assistant/suggestions.py:188
msgid "Is there a key for it?"
msgstr "C'è un tasto per farlo?"

#: src/meridiana/assistant/suggestions.py:189
msgid "Where is it in the menus?"
msgstr "Dov'è nei menu?"

#: src/meridiana/assistant/suggestions.py:190
msgid "Take me there"
msgstr "Portami lì"

#: src/meridiana/assistant/suggestions.py:192
msgid "Why exactly this change?"
msgstr "Perché proprio questa modifica?"

#: src/meridiana/assistant/suggestions.py:193
msgid "Is there another way?"
msgstr "C'è un'altra strada?"

#: src/meridiana/assistant/suggestions.py:194
msgid "How much does the energy change if I apply it?"
msgstr "Quanto cambia la produzione se la applico?"

#: src/meridiana/assistant/suggestions.py:335
msgid "Yes, take me there"
msgstr "Sì, portami lì"

#: src/meridiana/assistant/suggestions.py:335
msgid "Yes, propose it"
msgstr "Sì, proponimelo"

#: src/meridiana/assistant/suggestions.py:335
msgid "First tell me why"
msgstr "Prima dimmi perché"

#: src/meridiana/assistant/tools.py:261
msgid "the site"
msgstr "il sito"

