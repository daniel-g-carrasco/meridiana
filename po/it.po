msgstr "&Cataloghi"

#: src/meridiana/ui/window.py:985
msgid "Import a module from PVsyst (.PAN)…"
msgstr "Importa un modulo da PVsyst (.PAN)…"

#: src/meridiana/ui/window.py:986
