ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView_V2.0]'),'2;1');
FILE_NAME('muro-strati.ifc','2026-11-14T00:00:00',(''),(''),'','Meridiana tests','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0000000000000000000001',$,'Muro a strati R608',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#8=IFCSITE('0000000000000000000002',$,'Sito',$,$,#7,$,$,.ELEMENT.,$,$,$,$,$);
#9=IFCBUILDING('0000000000000000000003',$,'Edificio',$,$,#7,$,$,.ELEMENT.,$,$,$);
#10=IFCBUILDINGSTOREY('0000000000000000000004',$,'Piano terra',$,$,#7,$,$,.ELEMENT.,0.);
#11=IFCRELAGGREGATES('0000000000000000000005',$,$,$,#6,(#8));
#12=IFCRELAGGREGATES('0000000000000000000006',$,$,$,#8,(#9));
#13=IFCRELAGGREGATES('0000000000000000000007',$,$,$,#9,(#10));
#14=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000008',$,$,$,(#100,#200,#300),#10);
#20=IFCDIRECTION((0.,0.,1.));
#21=IFCDIRECTION((1.,0.,0.));
#22=IFCDIRECTION((0.,1.,0.));
/* the two colours of the walls: a dark core, light skins (as a wall drawn layer by layer) */
#30=IFCCOLOURRGB($,0.47,0.47,0.47);
#31=IFCSURFACESTYLERENDERING(#30,0.,$,$,$,$,$,$,.NOTDEFINED.);
#32=IFCSURFACESTYLE('core',.BOTH.,(#31));
#33=IFCCOLOURRGB($,0.93,0.93,0.93);
#34=IFCSURFACESTYLERENDERING(#33,0.,$,$,$,$,$,$,.NOTDEFINED.);
#35=IFCSURFACESTYLE('plaster',.BOTH.,(#34));
#36=IFCCOLOURRGB($,0.,0.5,0.75);
#37=IFCSURFACESTYLERENDERING(#36,0.6,$,$,$,$,$,$,.NOTDEFINED.);
#38=IFCSURFACESTYLE('glass',.BOTH.,(#37));
/* the layers of a wall 5 m long and 3 m high in x: inner skin y 0-0.02, core 0.02-0.28, outer skin 0.28-0.30 */
#40=IFCCARTESIANPOINT((2.5,0.01));
#41=IFCAXIS2PLACEMENT2D(#40,$);
#42=IFCRECTANGLEPROFILEDEF(.AREA.,'skin in',#41,5.,0.02);
#43=IFCCARTESIANPOINT((2.5,0.15));
#44=IFCAXIS2PLACEMENT2D(#43,$);
#45=IFCRECTANGLEPROFILEDEF(.AREA.,'core',#44,5.,0.26);
#46=IFCCARTESIANPOINT((2.5,0.29));
#47=IFCAXIS2PLACEMENT2D(#46,$);
#48=IFCRECTANGLEPROFILEDEF(.AREA.,'skin out',#47,5.,0.02);
/* 1. the wall: its core first, then the two skins */
#101=IFCLOCALPLACEMENT(#7,#4);
#102=IFCEXTRUDEDAREASOLID(#45,#4,#20,3.);
#103=IFCEXTRUDEDAREASOLID(#42,#4,#20,3.);
#104=IFCEXTRUDEDAREASOLID(#48,#4,#20,3.);
#105=IFCSTYLEDITEM(#102,(#32),$);
#106=IFCSTYLEDITEM(#103,(#35),$);
#107=IFCSTYLEDITEM(#104,(#35),$);
#108=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#102,#103,#104));
#109=IFCPRODUCTDEFINITIONSHAPE($,$,(#108));
#100=IFCWALL('1000000000000000000001',$,'Muro a strati',$,$,#101,#109,$,.NOTDEFINED.);
/* 2. the same wall 5 m further in y, with a window opening 1 x 2 m through all its layers */
#201=IFCCARTESIANPOINT((0.,5.,0.));
#202=IFCAXIS2PLACEMENT3D(#201,$,$);
#203=IFCLOCALPLACEMENT(#7,#202);
#204=IFCEXTRUDEDAREASOLID(#45,#4,#20,3.);
#205=IFCEXTRUDEDAREASOLID(#42,#4,#20,3.);
#206=IFCEXTRUDEDAREASOLID(#48,#4,#20,3.);
#207=IFCSTYLEDITEM(#204,(#32),$);
#208=IFCSTYLEDITEM(#205,(#35),$);
#209=IFCSTYLEDITEM(#206,(#35),$);
#210=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#204,#205,#206));
#211=IFCPRODUCTDEFINITIONSHAPE($,$,(#210));
#200=IFCWALL('2000000000000000000001',$,'Muro a strati con finestra',$,$,#203,#211,$,.NOTDEFINED.);
#220=IFCCARTESIANPOINT((2.,-0.1,0.5));
#221=IFCAXIS2PLACEMENT3D(#220,$,$);
#222=IFCLOCALPLACEMENT(#203,#221);
#223=IFCCARTESIANPOINT((0.5,-1.));
#224=IFCAXIS2PLACEMENT2D(#223,$);
#225=IFCRECTANGLEPROFILEDEF(.AREA.,'1 x 2',#224,1.,2.);
#226=IFCAXIS2PLACEMENT3D(#3,#22,#21);
#227=IFCEXTRUDEDAREASOLID(#225,#226,#20,0.5);
#228=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#227));
#229=IFCPRODUCTDEFINITIONSHAPE($,$,(#228));
#230=IFCOPENINGELEMENT('2000000000000000000002',$,'Finestra',$,$,#222,#229,$,.OPENING.);
#231=IFCRELVOIDSELEMENT('2000000000000000000003',$,$,$,#200,#230);
/* 3. a window as a representation map: a frame and a pane of glass, each with its style */
#301=IFCCARTESIANPOINT((0.,10.,0.));
#302=IFCAXIS2PLACEMENT3D(#301,$,$);
#303=IFCLOCALPLACEMENT(#7,#302);
#310=IFCCARTESIANPOINT((0.5,0.05));
#311=IFCAXIS2PLACEMENT2D(#310,$);
#312=IFCRECTANGLEPROFILEDEF(.AREA.,'frame',#311,1.,0.1);
#313=IFCEXTRUDEDAREASOLID(#312,#4,#20,0.1);
#314=IFCCARTESIANPOINT((0.5,0.05));
#315=IFCAXIS2PLACEMENT2D(#314,$);
#316=IFCRECTANGLEPROFILEDEF(.AREA.,'pane',#315,0.9,0.02);
#317=IFCCARTESIANPOINT((0.,0.,0.1));
#318=IFCAXIS2PLACEMENT3D(#317,$,$);
#319=IFCEXTRUDEDAREASOLID(#316,#318,#20,1.4);
#320=IFCSTYLEDITEM(#313,(#35),$);
#321=IFCSTYLEDITEM(#319,(#38),$);
#322=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#313,#319));
#323=IFCREPRESENTATIONMAP(#4,#322);
#324=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#3,1.,$);
#325=IFCMAPPEDITEM(#323,#324);
#326=IFCSHAPEREPRESENTATION(#5,'Body','MappedRepresentation',(#325));
#327=IFCPRODUCTDEFINITIONSHAPE($,$,(#326));
#300=IFCWINDOW('3000000000000000000001',$,'Finestra mappata',$,$,#303,#327,$,1.5,1.,.WINDOW.,.SINGLE_PANEL.,$);
ENDSEC;
END-ISO-10303-21;
