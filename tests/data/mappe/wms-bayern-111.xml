      <Keyword>Luftbildaufnahmen</Keyword>
      <Keyword>kostenfrei</Keyword>
      <Keyword>opendata</Keyword>
  </KeywordList>
  <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://geoservices.bayern.de"/>
  <ContactInformation>
