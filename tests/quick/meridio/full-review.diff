+                    M.MenuItem { text: root.docked ? root.texts.floating : root.texts.dock; onTriggered: { root.docked = !root.docked; root.placementSaved(root.avatarX, root.avatarY, root.bubbleWidth, root.bubbleHeight, root.docked) } }
