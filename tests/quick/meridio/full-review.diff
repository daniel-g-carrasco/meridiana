+                onClicked: root.backend.ask(modelData)
+            }
+        }
+    }
+    M.Label {
+        Layout.fillWidth: true
+        text: root.backend ? root.backend.status : ""
+        visible: text.length > 0; wrapMode: Text.Wrap; textStyle: "caption"
+    }
+    M.Label {
+        Layout.fillWidth: true
+        text: root.backend ? root.backend.costLine : ""
+        visible: text.length > 0; wrapMode: Text.Wrap; textStyle: "caption"
+    }
+    RowLayout {
+        Layout.fillWidth: true
+        M.TextField {
+            id: question
+            objectName: "assistantQuestion"
+            Layout.fillWidth: true
+            placeholderText: root.texts.question
+            text: root.backend ? root.backend.draft : ""
+            onTextEdited: if (root.backend) root.backend.setDraft(text)
+            Keys.onPressed: event => {
+                if (event.matches(StandardKey.Paste) && root.backend && root.backend.pasteClipboard()) event.accepted = true
+            }
+            onAccepted: submit()
+            function submit() { if (root.backend && !root.backend.busy && text.trim()) { root.backend.ask(text); text = "" } }
+        }
+        M.Button {
+            iconName: root.backend && root.backend.busy ? "square" : "send"
+            tip: root.backend && root.backend.busy ? root.texts.stop : root.texts.send
+            enabled: !!root.backend
+            onClicked: root.backend.busy ? root.backend.stop() : question.submit()
+        }
+    }
+    RowLayout {
+        M.Button { iconName: "paperclip"; tip: root.texts.attach; enabled: !!root.backend; onClicked: files.open() }
+        M.Button { iconName: "eye"; tip: root.texts.view; enabled: root.backend ? root.backend.canShowView : false; onClicked: root.backend.showView() }
+        Item { Layout.fillWidth: true }
+    }
+    FileDialog {
+        id: files
+        title: root.texts.attach
+        fileMode: FileDialog.OpenFiles
+        onAccepted: if (root.backend) root.backend.addAttachments(selectedFiles.map(url => decodeURIComponent(url.toString().replace(/^file:\/\//, "").replace(/^\/(.:)/, "$1"))))
+    }
+    DropArea {
+        // Explicit geometry keeps this overlay outside ColumnLayout's size negotiation.
+        width: root.width; height: root.height
+        onDropped: drop => { if (root.backend && drop.hasUrls) root.backend.addAttachments(drop.urls.map(url => decodeURIComponent(url.toString().replace(/^file:\/\//, "").replace(/^\/(.:)/, "$1")))) }
+    }
+    Connections {
+        target: root.backend
+        function onAttachmentsRequested() { files.open() }
+        function onPreviewChanged() { if (root.backend.preview.title) preview.open(); else preview.close() }
+    }
+    Popup {
+        id: preview
+        parent: Overlay.overlay
+        anchors.centerIn: parent
+        width: Math.min(600, parent.width - 32); height: Math.min(650, parent.height - 32)
+        modal: true; padding: 16
+        background: Rectangle { color: Theme.colors.panel; radius: Theme.radius.CARD; border.color: Theme.colors.line }
+        onClosed: if (root.backend) root.backend.closePreview()
+        ColumnLayout {
+            anchors.fill: parent
+            M.Label { text: root.backend ? (root.backend.preview.title || "") : ""; textStyle: "title"; Layout.fillWidth: true; wrapMode: Text.Wrap }
+            Image {
+                Layout.fillWidth: true; Layout.fillHeight: true
+                source: root.backend ? (root.backend.preview.imageSource || "") : ""
+                visible: source.toString().length > 0; fillMode: Image.PreserveAspectFit
+            }
+            ScrollView {
+                Layout.fillWidth: true; Layout.fillHeight: true
+                TextArea {
+                    text: root.backend ? (root.backend.preview.text || "") : ""
+                    readOnly: true; selectByMouse: true; wrapMode: TextEdit.Wrap
+                    color: Theme.colors.text; font.family: Theme.fontFamily; font.pixelSize: Theme.text.body.size
+                }
+            }
+            M.Button { text: root.texts.close; onClicked: preview.close() }
+        }
+    }
+}
