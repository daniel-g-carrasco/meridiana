+class ChatSignals(QObject):
+    text = Signal(int, str)                 # generation, a piece of the answer
+    done = Signal(int, object)              # generation, conversation.Round
+    failed = Signal(int, object)            # generation, providers.ProviderError
+
+
+class ChatJob(QRunnable):
+    """One round of the model, away from the window's thread: the provider's stream gathered, each piece told."""
+
+    def __init__(self, generation: int, provider, system: str, messages: list, specs: list):
+        super().__init__()
+        self.generation, self.provider, self.system, self.messages, self.specs = (generation, provider, system,
+                                                                                   messages, specs)
+        self.signals = ChatSignals()
+
+    def run(self):
+        g = self.generation
+        try:
+            r = conversation.collect(self.provider, self.system, self.messages, self.specs,
+                                     lambda piece: tell(self.signals.text, g, piece))
+        except providers.ProviderError as error:
+            tell(self.signals.failed, g, error)
+            return
+        except Exception as error:          # noqa: BLE001  a thread's boundary: said, not lost
+            log.complain("assistant", error)
+            tell(self.signals.failed, g, providers.ProviderError("bad", str(error)))
+            return
+        tell(self.signals.done, g, r)
+
+
+class WorkSignals(QObject):
+    done = Signal(object)
+
+
+class Work(QRunnable):
+    """A slow read away from the window's thread: the local models of this PC (a closed port takes two seconds to
+    refuse on Windows), the test of a connection. `fn()`'s result told with `done`; what fails is logged and
+    `fallback()` told instead."""
+
+    def __init__(self, fn, fallback=lambda: None):
+        super().__init__()
+        self.fn, self.fallback = fn, fallback
+        self.signals = WorkSignals()
+        self.over = False
+
+    def run(self):
+        try:
+            result = self.fn()
+        except Exception as error:          # noqa: BLE001  a thread's boundary: said, not lost
+            log.complain("assistant", error)
+            result = self.fallback()
+        tell(self.signals.done, result)
+        self.over = True
+
+
+def port_of(url: str) -> int:
+    from urllib.parse import urlparse
+    try:
+        return urlparse(url).port or 0
+    except ValueError:
+        return 0
+
diff --git a/src/meridiana/quick/backend/assistant_help.py b/src/meridiana/quick/backend/assistant_help.py
new file mode 100644
index 0000000..9189f44
--- /dev/null
+++ b/src/meridiana/quick/backend/assistant_help.py
@@ -0,0 +1,195 @@
+"""Help, internal manual and guided-tour content for the Quick assistant.
+
+Geometry belongs to AssistantLayer.qml. This service only changes on a command,
+never during a pointer move, layout animation or spotlight pulse.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict
+
+from PySide6.QtCore import QObject, Property, Signal, Slot
+
+from meridiana import help as helps, tour
+from meridiana.i18n import _
+
+
+class AssistantHelp(QObject):
+    changed = Signal()
+    requested = Signal()
+    manualOpened = Signal()
+    tourChanged = Signal()
+    askRequested = Signal(str)
+    howRequested = Signal(str)
+    navigateRequested = Signal(list)
+    dismissed = Signal()
+
+    def __init__(self, parent=None, *, cfg=None, save=lambda: None):
+        super().__init__(parent)
+        self.cfg, self.save = cfg, save
+        self._content = {}
+        self._manual = ''
+        self._chapter = ''
+        self._anchor = ''
+        self._index = 0
+        self._active = False
+        self._chapters = []
+        root = helps.manual_dir()
+        if root:
+            for chapter in helps.CHAPTERS:
+                path = root / chapter
+                if path.is_file():
+                    self._chapters.append({'id': chapter, 'title': helps.chapter_title(path.read_text(encoding='utf-8'))})
+
+    @Property('QVariantMap', notify=changed)
+    def content(self):
+        return self._content
+
+    @Property('QVariantList', constant=True)
+    def chapters(self):
+        return self._chapters
+
+    @Property(str, notify=changed)
+    def manualText(self):
+        return self._manual
+
+    @Property(str, notify=changed)
+    def manualChapter(self):
+        return self._chapter
+
+    @Property(str, notify=changed)
+    def manualAnchor(self):
+        return self._anchor
+
+    @Property('QVariantMap', constant=True)
+    def labels(self):
+        return dict(manual=_('Manual'), ask=_('Ask Meridio'), how=_('How it is computed'),
+                    previous=_('Previous'), next=_('Next'), later=_('Later'), finish=_('Finish'),
+                    close=_('Close'), source=_('Source'), tour=_('Guided tour'))
+
+    @Slot(str, result=bool)
+    def request(self, key):
+        item = helps.get(key)
+        if item is None:
+            return False
+        self._content = {**asdict(item), 'id': key, 'sources': helps.sources(item)}
+        self.changed.emit()
+        self.requested.emit()
+        return True
+
+    @Slot()
+    def ask(self):
+        item = helps.get(self._content.get('id', ''))
+        if item:
+            self.askRequested.emit(helps.question(item))
+
+    @Slot()
+    def how(self):
+        if self._content.get('pedigree'):
+            self.howRequested.emit(self._content['pedigree'])
+
+    @Slot(str, result=bool)
+    def openManual(self, reference):
+        chapter, anchor = helps.split(reference)
+        chapter = chapter or self._chapter or 'README.md'
+        root = helps.manual_dir()
+        if not root or chapter not in helps.CHAPTERS:
+            return False
+        path = root / chapter
+        if not path.is_file():
+            return False
+        self._manual = path.read_text(encoding='utf-8')
+        self._chapter, self._anchor = chapter, anchor
+        self.changed.emit()
+        self.manualOpened.emit()
+        return True
+
+    @Slot(str, result=int)
+    def anchorPosition(self, anchor):
+        """Approximate text offset for Quick TextEdit.positionToRectangle.
+
+        QTextDocument supplies the exact rendered character positions to QML;
+        this method uses the same Markdown parser to avoid raw-source offsets.
+        """
+        from PySide6.QtGui import QTextDocument
+        doc = QTextDocument()
+        doc.setMarkdown(self._manual)
+        for (_level, heading), slug in zip(helps.headings(self._manual), helps.anchors(self._manual), strict=True):
+            if slug == anchor:
+                found = doc.find(heading)
+                return found.selectionStart() if not found.isNull() else 0
+        return 0
+
+    @Slot(str, result=bool)
+    def followLink(self, reference):
+        from PySide6.QtCore import QUrl
+        from PySide6.QtGui import QDesktopServices
+        url = QUrl(reference)
+        if url.scheme() in ('https', 'http'):
+            return QDesktopServices.openUrl(url)
+        return self.openManual(reference)
+
+    @Property(bool, notify=tourChanged)
+    def tourActive(self):
+        return self._active
+
+    @Property(int, notify=tourChanged)
+    def tourIndex(self):
+        return self._index
+
+    @Property('QVariantMap', notify=tourChanged)
+    def tourStep(self):
+        items = tour.steps()
+        step = items[self._index]
+        return {**asdict(step), 'points': list(step.points), 'target': list(step.target),
+                'number': self._index + 1, 'total': len(items),
+                'progress': _('Step {n} of {total}').format(n=self._index + 1, total=len(items))}
+
+    def _save_tour(self, status):
+        if self.cfg is not None:
+            self.cfg.tour_status, self.cfg.tour_step = status, self._index
+            self.save()
+
+    def _show_step(self):
+        self._save_tour('active')
+        self.tourChanged.emit()
+        self.navigateRequested.emit(list(tour.steps()[self._index].target))
+
+    @Slot(bool)
+    def startTour(self, resume=False):
+        self._index = min(max(0, int(getattr(self.cfg, 'tour_step', 0))) if resume else 0, len(tour.steps()) - 1)
+        self._active = True
+        self._show_step()
+
+    @Slot(int)
+    def goToStep(self, index):
+        if 0 <= index < len(tour.steps()):
+            self._index = index
+            self._active = True
+            self._show_step()
+
+    @Slot()
+    def next(self):
+        if not self._active:
+            return
+        if self._index == len(tour.steps()) - 1:
+            self._active = False
+            self._save_tour('done')
+            self.tourChanged.emit()
+            self.dismissed.emit()
+        else:
+            self._index += 1
+            self._show_step()
+
+    @Slot()
+    def previous(self):
+        if self._active and self._index:
+            self._index -= 1
+            self._show_step()
+
+    @Slot()
+    def pauseTour(self):
+        if self._active:
+            self._active = False
+            self._save_tour('paused')
+            self.tourChanged.emit()
+            self.dismissed.emit()
diff --git a/src/meridiana/quick/backend/assistant_local.py b/src/meridiana/quick/backend/assistant_local.py
new file mode 100644
index 0000000..6178fab
--- /dev/null
+++ b/src/meridiana/quick/backend/assistant_local.py
@@ -0,0 +1,149 @@
+"""Local runtime discovery, selection and tool-call probe, without visual widgets."""
+from dataclasses import replace
+
+from PySide6.QtCore import QObject, Property, QThreadPool, Signal, Slot
+from ...assistant import local, providers
+from ...i18n import _, number
+
+
+class LocalModels(QObject):
+    changed = Signal()
+    chosen = Signal(str, str, str)
+    surveyed = Signal(object)
+    tested = Signal(object)
+
+    def __init__(self, survey=None, current=lambda: ("", "", ""), parent=None, check=None):
+        super().__init__(parent)
+        self.survey, self.check = survey or local.survey, check or local.check
+        self.current = current
+        self.found = None
+        self.jobs = []
+        self._models, self._guide, self._runtimes = [], [], []
+        self._status, self._test_status, self._machine = "", "", ""
+        self._busy, self._testing = False, False
+        self._index, self._testing_model = -1, ""
+        self._pairs = []
+        self._test_provider = None
+
+    models = Property("QVariantList", lambda self: self._models, notify=changed)
+    runtimes = Property("QVariantList", lambda self: self._runtimes, notify=changed)
+    guide = Property("QVariantList", lambda self: self._guide, notify=changed)
+    status = Property(str, lambda self: self._status, notify=changed)
+    testStatus = Property(str, lambda self: self._test_status, notify=changed)
+    machine = Property(str, lambda self: self._machine, notify=changed)
+    busy = Property(bool, lambda self: self._busy, notify=changed)
+    testing = Property(bool, lambda self: self._testing, notify=changed)
+    selectedIndex = Property(int, lambda self: self._index, notify=changed)
+    needsRam = Property(bool, lambda self: self.found is not None and not self.found.machine.ram_gb, notify=changed)
+
+    @Slot()
+    def start(self):
+        if self._busy:
+            return
+        from .assistant_chat import Work, port_of
+        self._busy = True
+        self._status = _("Looking for the local models on this PC…")
+        self.changed.emit()
+        url = self.current()[0]
+        extra = (port_of(url),) if url else ()
+        job = Work(lambda: self.survey(extra=extra), local.Survey)
+        job.signals.done.connect(self.show_survey)
+        self._run(job)
+
+    def _run(self, job):
+        self.jobs = [j for j in self.jobs if not j.over] + [job]
+        QThreadPool.globalInstance().start(job)
+
+    @Slot(object)
+    def show_survey(self, found):
+        self.found, self._busy = found, False
+        self._runtimes = [{"name": rt.name, "url": rt.url, "running": rt.running, "installed": rt.installed,
+                           "version": rt.version, "note": rt.note, "start": rt.start(), "count": len(rt.models)}
+                          for rt in found.runtimes]
+        self._pairs = [(rt, model) for rt in found.running for model in rt.models]
+        self._models = []
+        best = found.choice
+        self._index = 0 if self._pairs else -1
+        for index, (runtime, model) in enumerate(self._pairs):
+            fits = not model.size or not found.machine.budget_gb or local.need_gb(model.gb) <= found.machine.budget_gb
+            choice = local.Choice(runtime, model, local.match(model.name), fits)
+            recommended = best is not None and best.model is model
+            if recommended:
+                self._index = index
+            self._models.append({"name": model.name, "runtime": runtime.name, "url": runtime.url,
+                                 "sizeGb": model.gb, "reason": choice.reason(found.machine),
+                                 "enabled": model.tools is not False and not runtime.locked,
+                                 "recommended": recommended})
+        self._status = "\n".join(rt.name + ": " + (rt.url if rt.running else rt.start())
+                                 for rt in found.runtimes)
+        if not self._status:
+            self._status = _("No program of local models on this PC (Ollama, LM Studio, llama.cpp, Jan, Lemonade, Docker Model Runner): none answers and none is on the disk.")
+        pc = found.machine
+        gpu = _(", {gpu} with {vram} GB").format(gpu=pc.gpu, vram=number(pc.vram_gb, 0)) if pc.vram_gb else ""
+        self._machine = _("This PC: {ram} GB of RAM{gpu}; about {budget} GB for a model.").format(
+            ram=number(pc.ram_gb, 0), gpu=gpu, budget=number(pc.budget_gb, 0)) if pc.ram_gb else ""
+        self._guide = []
+        if best is None and pc.ram_gb:
+            candidate, steps = local.guide(pc, have_ollama=any(rt.kind == "ollama" for rt in found.runtimes))
+            self._guide = [{"text": step.text, "command": step.command} for step in steps]
+            self._guide.insert(0, {"text": candidate.title + ": " + candidate.why(), "command": "",
+                                   "url": "https://ollama.com/library/" + candidate.ollama})
+        self.changed.emit()
+        self.surveyed.emit(found)
+
+    @Slot(float)
+    def setRam(self, ram):
+        if self.found is not None and 1 <= ram <= 2048:
+            self.found.machine = replace(self.found.machine, ram_gb=ram)
+            self.show_survey(self.found)
+
+    @Slot(int)
+    def select(self, index):
+        if 0 <= index < len(self._pairs):
+            self._index = index
+            self.changed.emit()
+
+    @Slot()
+    def useSelected(self):
+        if not 0 <= self._index < len(self._pairs) or not self._models[self._index]["enabled"]:
+            return
+        rt, model = self._pairs[self._index]
+        self.chosen.emit(rt.url, model.name, "ollama" if rt.api == "ollama" else "")
+
+    def provider(self):
+        url, model, api = self.current()
+        if api == "ollama":
+            provider = providers.Ollama(model=model, base_url=url or "http://127.0.0.1:11434")
+        else:
+            provider = providers.OpenAICompatible(model=model, base_url=url or "http://127.0.0.1:9931/v1")
+        provider.max_tokens = 256
+        return provider
+
+    @Slot()
+    def probe(self):
+        if self._testing:
+            return
+        from .assistant_chat import Work
+        provider = self.provider()
+        self._test_provider = provider
+        self._testing_model = provider.model or _("the one the server serves")
+        self._testing = True
+        self._test_status = _("Trying {model}… The first time the server loads it from the disk: it can take a minute.").format(model=self._testing_model)
+        self.changed.emit()
+        job = Work(lambda: self.check(provider), lambda: local.Check(False, error="bad"))
+        job.signals.done.connect(self._tested)
+        self._run(job)
+
+    @Slot(object)
+    def _tested(self, result):
+        self._testing = False
+        self._test_provider = None
+        self._test_status = local.said(result, self._testing_model)
+        self.changed.emit()
+        self.tested.emit(result)
+
+    @Slot()
+    def cancelProbe(self):
+        if self._test_provider is not None:
+            self._test_provider.cancel()
+
diff --git a/src/meridiana/quick/backend/assistant_setup.py b/src/meridiana/quick/backend/assistant_setup.py
new file mode 100644
index 0000000..6502cf4
--- /dev/null
+++ b/src/meridiana/quick/backend/assistant_setup.py
@@ -0,0 +1,89 @@
+"""Credential-free provider profiles exposed to QML. Saving never sends a request."""
+from PySide6.QtCore import QObject, Property, Signal, Slot
+from PySide6.QtGui import QDesktopServices
+from PySide6.QtCore import QUrl
+
+from ...assistant import keys, setup
+from ...i18n import _
+from .assistant_local import LocalModels
+
+
+class AssistantSetup(QObject):
+    changed = Signal()
+    configured = Signal(str)
+    dismissed = Signal()
+
+    def __init__(self, cfg, save_config=lambda: None, parent=None, *, key_store=None):
+        super().__init__(parent)
+        self.cfg, self.save_config = cfg, save_config
+        self.keys = key_store if key_store is not None else keys
+        provider = setup.canonical(cfg.assistant_provider)
+        self._provider = provider if provider in setup.CLOUD else "openai"
+        self._status = _("Saving makes no API request. Sending a question asks for consent first.")
+        self._local = LocalModels(current=lambda: (cfg.assistant_local_url, cfg.assistant_local_model,
+                                                   cfg.assistant_local_runtime), parent=self)
+        self._local.chosen.connect(self.saveLocal)
+
+    providers = Property("QVariantList", lambda self: [
+        {"id": key, "text": spec.name, "docs": spec.docs} for key, spec in setup.CLOUD.items()], constant=True)
+    provider = Property(str, lambda self: self._provider, notify=changed)
+    model = Property(str, lambda self: setup.profile(self.cfg, self._provider)["model"], notify=changed)
+    endpoint = Property(str, lambda self: setup.profile(self.cfg, self._provider)["endpoint"], notify=changed)
+    accountUrl = Property(str, lambda self: setup.CLOUD[self._provider].docs, notify=changed)
+    status = Property(str, lambda self: self._status, notify=changed)
+    localModels = Property(QObject, lambda self: self._local, constant=True)
+
+    @Slot(str)
+    def chooseProvider(self, provider):
+        provider = setup.canonical(provider)
+        if provider in setup.CLOUD:
+            self._provider = provider
+            self.changed.emit()
+
+    @Slot(str, str, str, str, result=bool)
+    def saveCloud(self, provider, model, endpoint, key):
+        provider = setup.canonical(provider)
+        try:
+            if provider not in setup.CLOUD:
+                raise ValueError(_("Choose a provider."))
+            model = model.strip()
+            endpoint = setup.validate_endpoint(endpoint)
+            if not model:
+                raise ValueError(_("Enter the model ID from your provider account."))
+            key = key.strip()
+            if not key and not self.keys.get(provider):
+                raise ValueError(_("Paste the API key from your provider account."))
+            if key:
+                self.keys.put(provider, key)
+                setup.keys_changed()
+            setup.remember(self.cfg, provider, model, endpoint)
+            self.cfg.assistant_provider = provider
+            self.save_config()
+        except (ValueError, keys.KeyringMissing) as error:
+            self._status = _("Configuration not saved: {why}").format(why=error)
+            self.changed.emit()
+            return False
+        self._provider = provider
+        self._status = _("Configured. Credentials and model access are checked only when you send a question.")
+        self.changed.emit()
+        self.configured.emit(provider)
+        return True
+
+    @Slot(str, str, str)
+    def saveLocal(self, url, model, runtime):
+        self.cfg.assistant_provider = "local"
+        self.cfg.assistant_local_url = url
+        self.cfg.assistant_local_model = model
+        self.cfg.assistant_local_runtime = runtime
+        self.save_config()
+        self.changed.emit()
+        self.configured.emit("local")
+
+    @Slot()
+    def openAccount(self):
+        QDesktopServices.openUrl(QUrl(self.accountUrl))
+
+    @Slot()
+    def dismiss(self):
+        self.dismissed.emit()
+
diff --git a/src/meridiana/quick/qml/Meridiana/Assistant/AssistantLayer.qml b/src/meridiana/quick/qml/Meridiana/Assistant/AssistantLayer.qml
new file mode 100644
index 0000000..7095084
--- /dev/null
+++ b/src/meridiana/quick/qml/Meridiana/Assistant/AssistantLayer.qml
@@ -0,0 +1,339 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import QtQuick.Shapes
+import Meridiana.Theme
+import Meridiana.Controls as M
+
+Item {
+    id: root
+    objectName: "assistantLayer"
+    property var chat: null
+    property var helpService: null
+    property var texts: assistantText
+    property bool assistantEnabled: true
+    property bool docked: false
+    property bool opened: false
+    property bool animated: true
+    property string characterStyle: "smooth"
+    property string page: "conversation"
+    property real avatarX: Math.max(12, width - 70)
+    property real avatarY: Math.max(12, height - 70)
+    property real bubbleWidth: 320
+    property real bubbleHeight: 500
+    property string tail: "right"
+    property real tailOffset: bubbleHeight - 23
+    property real bubbleX: 0
+    property real bubbleY: 0
+    property bool dragging: false
+    property bool resizing: false
+    property bool relocating: false
+    property bool whatsThis: false
+    property var returnState: null
+    property rect avoidRect: Qt.rect(0, 0, 0, 0)
+    property rect dockRect: Qt.rect(Math.max(0, width - 360), 0, Math.min(width, 360), height)
+    readonly property real actualWidth: docked ? dockRect.width : Math.min(bubbleWidth, Math.max(200, width - 70))
+    readonly property real actualHeight: docked ? dockRect.height : Math.min(bubbleHeight, height)
+    readonly property bool temporary: returnState !== null
+    readonly property bool characterVisible: assistantEnabled || temporary
+    signal placementSaved(real x, real y, real width, real height, bool docked)
+    signal attachmentRequested()
+    signal helpUnavailable(string id)
+
+    function clamp(n, lo, hi) { return Math.max(lo, Math.min(n, Math.max(lo, hi))) }
+    function intersects(a, b) {
+        return a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height
+    }
+    function shape(x, y, side) {
+        const w = actualWidth, h = actualHeight, aw = 46, gap = 4
+        const horizontal = side === "left" || side === "right"
+        const sameAxis = horizontal === (tail === "left" || tail === "right")
+        const desired = sameAxis ? tailOffset : (horizontal ? (y > height / 2 ? h - 23 : 23) : (x > width / 2 ? w - 23 : 23))
+        const at = clamp(desired, 23, (horizontal ? h : w) - 23)
+        if (side === "left") return Qt.rect(x + aw + gap, clamp(y + 23 - at, 0, height - h), w, h)
+        if (side === "right") return Qt.rect(x - gap - w, clamp(y + 23 - at, 0, height - h), w, h)
+        if (side === "top") return Qt.rect(clamp(x + 23 - at, 0, width - w), y + aw + gap, w, h)
+        return Qt.rect(clamp(x + 23 - at, 0, width - w), y - gap - h, w, h)
+    }
+    function fits(r) { return r.x >= 0 && r.y >= 0 && r.x + r.width <= width && r.y + r.height <= height }
+    function placeBubble() {
+        if (docked) return
+        const opposite = {left: "right", right: "left", top: "bottom", bottom: "top"}
+        const candidates = [tail, opposite[tail], "left", "right", "top", "bottom"]
+        for (let side of candidates) {
+            const r = shape(avatarX, avatarY, side)
+            if (fits(r)) {
+                if ((side === "left" || side === "right") !== (tail === "left" || tail === "right"))
+                    tailOffset = side === "left" || side === "right" ? avatarY + 23 - r.y : avatarX + 23 - r.x
+                tail = side; bubbleX = r.x; bubbleY = r.y; return
+            }
+        }
+        const fallback = shape(avatarX, avatarY, tail)
+        bubbleX = clamp(fallback.x, 0, width - actualWidth)
+        bubbleY = clamp(fallback.y, 0, height - actualHeight)
+    }
+    function remember() {
+        if (returnState === null) returnState = {x: avatarX, y: avatarY, opened: opened, page: page,
+                                                tail: tail, offset: tailOffset, width: bubbleWidth, height: bubbleHeight}
+    }
+    function moveBeside(rect) {
+        if (docked || rect.width <= 0) return
+        avoidRect = rect
+        // Compare complete character-and-bubble footprints, keeping the nearest free position.
+        const points = [[rect.x - 62, rect.y], [rect.x + rect.width + 16, rect.y],
+                        [12, 12], [width - 58, 12], [12, height - 58], [width - 58, height - 58]]
+        let best = null, score = Infinity
+        for (let p of points) {
+            const x = clamp(p[0], 0, width - 46), y = clamp(p[1], 0, height - 46)
+            if (intersects(Qt.rect(x, y, 46, 46), rect)) continue
+            for (let side of [tail, "left", "right", "top", "bottom"]) {
+                const r = shape(x, y, side)
+                if (!fits(r) || intersects(r, rect)) continue
+                const d = Math.hypot(x - avatarX, y - avatarY)
